        vector17 = load(vec16, waveform, 32);
        vector19 = load(vec16, waveform, 48);
        vector14 = load(vec16, waveform, 64);
        vector16 = load(vec16, waveform, 80);
        vector18 = load(vec16, waveform, 96);
        vector20 = load(vec16, waveform, 112);
        return;
