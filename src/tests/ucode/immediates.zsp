export fn _start() noreturn {
    reg large: u32 = 0x89ABCDEF;
    reg negative: i32 = -2147483648;
    reg upper_only: u32 = 0x12340000;
    reg signed_small: i32 = -32768;

    store(u32, 0, large);
    store(i32, 4, negative);
    store(u32, 8, upper_only);
    store(i32, 12, signed_small);
    @break();
}
