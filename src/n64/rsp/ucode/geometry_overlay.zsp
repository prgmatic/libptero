@rspq.command(13) fn patchCode(
    reg($a0) patch_address: u32,
    reg($a1) opcode_0: u32,
    reg($a2) opcode_1: u32,
) noreturn {
    reg($t0) size: u32 = undefined;
    reg($t1) pitch: u32 = undefined;
    reg($s0) rdram: u32 = undefined;
    reg($s4) scratch: dmem = undefined;
    exact {
        asm("or $s0, $zero, $a0");
        asm("ori $s4, $zero, 0x80");
        store(u32, scratch, opcode_0);
        store(u32, scratch, opcode_1, 4);
    }
    tail dma.out(size, pitch, rdram, scratch) slot {
        size = 7;
    }
}
