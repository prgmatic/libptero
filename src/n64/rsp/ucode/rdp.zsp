const dma = import("resident_api.zsp");
const queue = import("resident_api.zsp");

packed struct StagedRdpBufferState {
    current: u32;
    previous: u32;
}

bss {
    // Large enough for the longest RDP triangle command, matching libdragon.
    command_staging: [44]u32;
    mode_combiner_1cycle: [2]u32;
    mode_combiner_2cycle: [2]u32;
    extern rdp_current: u32;
    extern rdp_sentinel: u32;
    extern rdp_buffers: StagedRdpBufferState;
}

// Append/finalize interface: handlers stage one or more RDP commands, then
// `finalize` submits them with a single DMA.
pub fn write8(word0: u32, word1: u32) {
    reg end: dmem = load(u32, command_staging_ptr);
    store(u32, end, word0);
    store(u32, end, word1, 4);
    end += 8;
    store(u32, command_staging_ptr, end);
}

pub fn write16(
    word0: u32,
    word1: u32,
    word2: u32,
    word3: u32,
) {
    reg end: dmem = load(u32, command_staging_ptr);
    store(u32, end, word0);
    store(u32, end, word1, 4);
    store(u32, end, word2, 8);
    store(u32, end, word3, 12);
    end += 16;
    store(u32, command_staging_ptr, end);
}

pub inline fn setStagingEnd(staging_end: dmem) {
    store(u32, command_staging_ptr, staging_end);
}

pub inline fn loadCurrent(current: u32) {
    current = load(u32, rdp_current);
}

/// Takes the staged range and resets staging to empty.
pub inline fn prepareStagedSend(staging: dmem, staging_end: dmem) {
    staging = command_staging;
    staging_end = load(u32, command_staging_ptr);
    store(u32, command_staging_ptr, staging);
}

pub fn finalize() noreturn {
    reg staging: dmem;
    reg staging_end: dmem;
    prepareStagedSend(staging, staging_end);
    sendStaged(staging, staging_end);
    tail queue.commandLoop();
}

// Stackless RDP emission ABI: sends the staged commands between `dmem` and
// `staging_end` to the RDP buffer and returns through $ra. $sp is the
// resident secondary return-address register, and $t7 keeps the staged byte
// count for the caller.
pub fn sendStaged(
    reg($s4) dmem: dmem,
    reg($s3) staging_end: dmem,
) noreturn {
    staging_end &= 0x0fff;
    dmem &= 0x0fff;
    reg($at) reversed: u32 = signedLessThan(staging_end, dmem);
    if (reversed != 0) tail queue.invalidCommand() slot {
        reg($at) assertion_code: u32 = 0xc0060000;
    }

    reg($t7) size: u32 = staging_end - dmem;
    reg($sp) saved_return: u32 = undefined;
    reg($ra) return_address: u32 = undefined;
    // Nothing staged returns at once; the copy is harmless on that path.
    if (size == 0) tail dma.returnToCaller() slot {
        saved_return = return_address;
    }

    // The DMA and the buffer-switch command take fixed registers.
    reg($s0) rdram: u32 = load(u32, rdp_current);
    rdram &= 0x00ffffff;
    reg($a2) sentinel: u32 = load(u32, rdp_sentinel);
    sentinel -= size;
    reg($t1) previous_start: u32 = undefined;
    reg($a1) start: u32 = undefined;
    reg($t5) next_function: fn(i32, i32, i32) = &queue.rdpAppendBuffer;
    reg overflows: u32 = signedLessThan(sentinel, rdram);
    if (overflows != 0) {
        // The staged commands do not fit: wait until the RDP has finished
        // the previous buffer and swap to it.
        reg wait_mask: u32 = load(u8, rdp_syncfull_ongoing);
        wait_mask |= 0x00000200;
        while (true) {
            reg dp_status: u32 = rsp.cp0.rdpStatus();
            dp_status &= wait_mask;
            if (dp_status == 0) {
                break;
            }
        }
        rdram = rdp_buffers.previous;
        previous_start = rdp_buffers.current;
        rdp_buffers.current = rdram;
        rdp_buffers.previous = previous_start;
        sentinel = rdram + 0x00010000;
        start = rdram;
        next_function = &queue.rdpSetBuffer;
    }

    reg($t0) dma_size: u32 = size - 1;
    reg($a0) next: u32 = rdram + size;
    dma.out(dma_size, previous_start, rdram, dmem);
    return_address = saved_return;
    jump(next_function);
}
