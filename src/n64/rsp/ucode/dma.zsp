const cp0 = @import("cp0.zsp");

// Stackless DMA ABI, matching libdragon's rsp_dma.inc:
//   $t0: DMA size descriptor
//   $t1: RDRAM pitch
//   $s0: RDRAM address
//   $s4: DMEM address
//   $t2: operation flags
//
// Returns through $ra. Clobbers $t2 and $t3. For DMA reads, $s4 is adjusted
// by the low three bits of the RDRAM address.
pub fn out(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: u32,
) noreturn {
    reg($t2) flags: u32 = -32756;
    @goto(exec);
}

pub fn outAsync(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: u32,
) noreturn {
    reg($t2) flags: u32 = -32768;
    @goto(exec);
}

pub fn inAsync(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: u32,
) noreturn {
    reg($t2) flags: u32 = 0;
    @goto(exec);
}

pub fn in(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: u32,
) noreturn {
    reg($t2) flags: u32 = 0x0c;
}

pub fn exec(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: u32,
    reg($t2) flags: u32,
) noreturn {
    reg dma_full: u32 = undefined;
    reg transfer_descriptor: u32;
    do {
        cp0.getDmaFullAt(dma_full);
    } while(dma_full != 0) delay {
        transfer_descriptor = size & 0x0fff;
    }
    transfer_descriptor = pitch - transfer_descriptor;
    transfer_descriptor -= 1;
    transfer_descriptor <<= 20;
    transfer_descriptor |= size;
    cp0.setDmaAddrRdram(rdram);
    if(flags < 0x80000000) delay {
        cp0.setDmaAddrRsp(dmem);
    } {
        cp0.setDmaReadAt(transfer_descriptor);
    } else {
        cp0.setDmaWriteAt(transfer_descriptor);
    }
    reg rdram_alignment: u32;
    rdram_alignment = rdram & 7;
    dmem = dmem + rdram_alignment;
    flags &= 0x0f;
    tail waitStatus(flags);
}

pub fn waitStatus(reg($t2) flags: u32) noreturn {
    reg status: u32 = undefined;
    cp0.getSpStatusAt(status);
    do {
        status &= flags;
    } while(status != 0) delay {
        cp0.getSpStatusAt(status);
    }
    tail returnToCaller();
}

pub fn returnToCaller() noreturn {
    reg($ra) return_address: u32 = undefined;
    @jump(return_address);
}

pub fn waitIdle() noreturn {
    reg($t2) flags: u32 = 0x0c;
    @goto(waitStatus);
}

pub fn waitOut() noreturn {
    reg($t2) flags: u32 = 0x08;
    @goto(waitStatus);
}
