export fn _start() noreturn {
    exact {
        asm("lw $s0, %lo(clipping_code_address)($zero)");
        asm("lhu $t0, %lo(clipping_code_size)($zero)");
        asm("addiu $t2, $zero, 12");
        asm("ori $ra, $zero, %lo(_start)");
        asm("sb $t0, %lo(clipping_code_address)($zero)");
        asm("j exec");
        asm("addiu $t0, $t0, -1");
    }
}

@rspq.command(4) fn loadVertices(
    reg($a0) buffer_size: u32,
    reg($a1) rdram_vertices: u32,
    reg($a2) input_output_addresses: u32,
) noreturn {
    exact {
        asm("srl $s4, $a2, 16");
        asm("srl $s6, $a1, 24");
        asm("andi $t0, $a0, 65535");
        asm("lw $s6, %lo(segment_table)($s6)");
        asm("addu $s7, $s4, $t0");
        asm("addiu $t0, $t0, -1");
        asm("or $t2, $zero, $zero");
        asm("jal exec");
        asm("addu $s0, $a1, $s6");
        asm("ori $s6, $zero, %lo(matrix_normal)");
        asm(".word 0xcad31801");
        asm(".word 0xcad21802");
        asm(".word 0xcad31c01");
        asm(".word 0xcad41800");
        asm(".word 0xcad41c00");
        asm("jal loadCurrentMVPMat");
        asm(".word 0xcad21c02");
        asm("ori $at, $zero, %lo(normal_mask_shift)");
        asm(".word 0xc8301801");
        asm(".word 0xc8311800");
        asm(".word 0xc8311c00");
        asm(".word 0xc8301c01");
        asm("ori $at, $zero, %lo(clipping_planes)");
        asm(".word 0xc82f1000");
        asm("ori $at, $zero, %lo(screen_scale_offset)");
        asm(".word 0xc82c1801");
        asm("andi $s6, $a2, 65535");
        asm("addiu $s5, $s6, 65500");
        asm("lbu $s2, %lo(active_light_size + 0)");
        asm(".word 0xc82c1c01");
        asm(".word 0xc82d1800");
        asm(".word 0xc82d1c00");
        asm("ori $at, $zero, %lo(fog_scale_offset)");
        asm(".word 0x4b2f03ea");
        asm(".word 0xc82b1800");
        asm(".word 0x4bff0384");
        asm("lbu $k0, %lo(triangle_command + 0)");
