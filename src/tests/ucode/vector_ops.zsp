inline fn addVectors(
    reg($v01) a: vec16,
    reg($v02) b: vec16,
    reg($v03) add_result: vec16,
) {
    add_result += b;
}

export fn _start() noreturn {
    reg input: dmem = 0;

    // Two vec16 inputs.
    reg seed: u32 = 0x00010002;
    store(u32, input, seed, 0);
    seed = 0xffff8000;
    store(u32, input, seed, 4);
    seed = 0x7fff1234;
    store(u32, input, seed, 8);
    seed = 0xaaaaf0f0;
    store(u32, input, seed, 12);

    seed = 0x00030004;
    store(u32, input, seed, 16);
    seed = 0x0001ffff;
    store(u32, input, seed, 20);
    seed = 0x00012222;
    store(u32, input, seed, 24);
    seed = 0x0f0f5555;
    store(u32, input, seed, 28);

    reg($v01) a: vec16 = load(vec16, input, 0);
    reg($v02) b: vec16 = load(vec16, input, 16);
    reg($v03) add_result: vec16 = 0;
    reg($v04) sub_result: vec16 = 0;
    reg($v05) and_result: vec16 = 0;
    reg($v06) or_result: vec16 = 0;
    reg($v07) xor_result: vec16 = 0;
    reg($v14) not_result: vec16 = 0;
    reg($v15) nor_result: vec16 = 0;
    reg($v16) mul_result: vec16 = 0;
    reg($v17) zero_factor: vec16 = 0;

    add_result = a;
    addVectors(a, b, add_result);
    sub_result = a - b;
    and_result = a;
    and_result &= b;
    or_result = a | b;
    xor_result = a ^ b;
    not_result = ~a;
    nor_result = a ~| b;
    mul_result.sfract = vmulf(a.sfract, zero_factor.x);
    mul_result.sfract = vmacf(b.sfract, zero_factor.yyyyyyyy);
    mul_result.ufract = vmulu(a.ufract, zero_factor);
    mul_result.ufract = vmacu(b.ufract, zero_factor);
    mul_result = vmudh(a, zero_factor);
    mul_result = vmadh(b, zero_factor);
    mul_result = accumulator(.high);
    mul_result = accumulator(.middle);
    mul_result = accumulator(.low);

    store(vec16, input, add_result, 0x100);
    store(vec16, input, sub_result, 0x110);
    store(vec16, input, and_result, 0x120);
    store(vec16, input, or_result, 0x130);
    store(vec16, input, xor_result, 0x140);
    store(vec16, input, not_result, 0x150);
    store(vec16, input, nor_result, 0x180);
    store(vec16, input, mul_result, 0x1a0);

    // Triangle assembly uses scalar lane moves and the RSP reciprocal unit.
    // For an input of 1, the RSP reciprocal ROM produces 0x7fffc000:
    // VRCP returns its low half and VRCPH retrieves its high half.
    reg($v18) reciprocal_result: vec16 = 0;
    reciprocal_result[0] = a[1];
    reciprocal_result[1] = vrcp(a[0]);
    reciprocal_result[2] = vrcph(a[0]);
    store(vec16, input, reciprocal_result, 0x1b0);

    reg($v19) unsigned_bytes: vec16 = loadVectorBytesUnsigned(input, 0);
    store(vec16, input, unsigned_bytes, 0x1c0);
    reg($v20) partial_words: vec16 = 0;
    partial_words = loadVectorWords(input, 0);
    partial_words = loadVectorWords(input, 8, 4);
    store(vec16, input, partial_words, 0x1d0);

    seed = 0x80402010;
    store(u32, input, seed, 0x70);
    seed = 0x08040201;
    store(u32, input, seed, 0x74);
    reg($v31) shift_vector: vec16 = loadVectorBytes(input, 0x70);
    reg($v21) shifted_left: vec16 = undefined;
    reg($v22) shifted_arithmetic: vec16 = undefined;
    reg($v23) shifted_logical: vec16 = undefined;
    shifted_left = a << 14;
    shifted_arithmetic = a >> 2;
    shifted_logical = a >>> 7;
    store(vec16, input, shifted_left, 0x1e0);
    store(vec16, input, shifted_arithmetic, 0x1f0);
    store(vec16, input, shifted_logical, 0x200);

    // A vec32 is an integer vector followed by its fractional rsp.vector.
    seed = 0x00010001;
    store(u32, input, seed, 32);
    store(u32, input, seed, 36);
    store(u32, input, seed, 40);
    store(u32, input, seed, 44);
    seed = 0xffffffff;
    store(u32, input, seed, 48);
    store(u32, input, seed, 52);
    store(u32, input, seed, 56);
    store(u32, input, seed, 60);

    seed = 0x00020002;
    store(u32, input, seed, 64);
    store(u32, input, seed, 68);
    store(u32, input, seed, 72);
    store(u32, input, seed, 76);
    seed = 0x00010001;
    store(u32, input, seed, 80);
    store(u32, input, seed, 84);
    store(u32, input, seed, 88);
    store(u32, input, seed, 92);

    reg($v08) wide_a: vec32 = load(vec32, input, 32);
    reg($v10) wide_b: vec32 = load(vec32, input, 64);
    reg($v12) wide_result: vec32 = 0;
    wide_result = wide_a + wide_b;
    store(vec32, input, wide_result, 0x160);

    rsp.halt();
}
