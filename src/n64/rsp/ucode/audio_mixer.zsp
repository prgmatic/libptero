    reg($s1) waveform: dmem = undefined;
    reg($s4) dma_dmem: dmem = undefined;
    reg($k0) channel_count: u32 = undefined;
    reserved reg($k1) sample_count: u32 = undefined;
    reg($gp) command_address: dmem = undefined;
    reg($fp) output_start: dmem = undefined;
    const zero: u32 = 0;
