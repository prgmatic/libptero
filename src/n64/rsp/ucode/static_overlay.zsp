data {
    overlay_value: [4]u32 = .{ 0x4f564c31, 0, 0, 0 };
}

state {
    persistent_counter: u32;
}

// The resident dispatcher enters at _start with the normal command-handler
// ABI and the handler returns through $ra.
@rspq.command(0) fn _start(
    reg($a0) command: u32,
) {
    reg dmem_address: dmem = 0;
    dmem_address = command & 0x00ffffff;
    reg value: u32 = load(u32, persistent_counter);
    value +%= 1;
    store(u32, persistent_counter, value);
    store(u32, dmem_address, value);
}

@rspq.command(1) fn writeArgument(
    reg($a0) command: u32,
    reg($a1) value: u32,
) {
    reg dmem_address: dmem = 0;
    dmem_address = command & 0x00ffffff;
    store(u32, dmem_address, value);
}
