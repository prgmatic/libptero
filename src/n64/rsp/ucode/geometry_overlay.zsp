@rspq.command(1) fn setScreenSize(
    reg($a0) guard_band_factor: u32,
    reg($a1) screen_offset_xy: u32,
    reg($a2) screen_scale_xy: u32,
    reg($a3) depth_and_w_scale: u32,
) noreturn {
    exact {
        asm(".word 0x0004ba02");
        asm(".word 0xa407034e");
        asm(".word 0x3084000f");
        asm(".word 0x0004b023");
        asm(".word 0xa0160343");
        asm(".word 0xa4170346");
        asm(".word 0xa0040337");
        asm(".word 0xa0040333");
        asm(".word 0xa016033f");
        asm(".word 0xac070314");
        asm(".word 0xac060310");
        asm("j commandLoop");
        asm(".word 0xac050318");
    }
}


@rspq.command(9) fn setFogState(reg($a0) enabled: u8) noreturn {
    jump queue.commandLoop() slot {
        store(u8, fog_store_offset, enabled);
    }
}

@rspq.command(5) fn setLight(
    reg($a0) address: dmem,
    reg($a1) rgba: u32,
    reg($a2) direction0: u32,
    reg($a3) direction1: u32,
) noreturn {
    exact {
        asm("beq $a2, $zero, geometry_set_light_end");
        asm("sw $a1, 0($a0)");
        asm("sw $a3, 12($a0)");
        asm("sw $a2, 8($a0)");
        asm("geometry_set_light_end:");
        asm("j commandLoop");
        asm("sw $a1, 4($a0)");
    }
}

@rspq.command(6) fn setRenderMode(
    reg($a0) culling: u8,
    reg($a1) command: u32,
) noreturn {
    exact {
        asm("lbu $s7, %lo(rdp_mode + 28)($zero)");
        asm("sb $a0, %lo(face_culling)($zero)");
        asm("andi $s7, $s7, 0x38");
        asm("or $a1, $a1, $s7");
        asm("j commandLoop");
        asm("sw $a1, %lo(triangle_command)($zero)");
    }
}

@rspq.command(7) fn setProjectionMatrix(reg($a0) rdram: u32) noreturn {
    exact {
        asm("addiu $t2, $zero, 12");
        asm("ori $t0, $zero, 63");
        asm("or $s0, $zero, $a0");
        asm("j exec");
        asm("ori $s4, $zero, %lo(matrix_projection)");
    }
}

@rspq.command(2) fn updateMatrixStack(
    reg($a0) stack_control: i32,
    reg($a1) matrix_address: i32,
) noreturn {
    exact {
        asm("andi $s7, $a0, 1");
        asm("andi $s6, $a0, 2");
        asm(".word 0x87840099");
        asm("lw $s5, %lo(matrix_stack_pointer)($zero)");
        asm("addu $s5, $s5, $a0");
        asm("bne $s6, $zero, commandLoop");
        asm("sw $s5, %lo(matrix_stack_pointer)($zero)");
        asm("srl $s3, $a1, 24");
        asm("lw $s3, %lo(segment_table)($s3)");
        asm("addu $a1, $a1, $s3");
        asm("bgez $a0, geometry_matrix_loaded_address");
        asm("ori $s4, $zero, %lo(matrix_mv)");
        asm("or $a1, $zero, $s5");
        asm("geometry_matrix_loaded_address:");
        asm("lui $at, 0xff");
        asm("ori $at, $at, 0xffff");
        asm("ori $t0, $zero, 63");
        asm("addiu $t2, $zero, 12");
        asm("jal exec");
        asm("and $s0, $a1, $at");
        asm("beq $s7, $zero, geometry_matrix_ready");
        asm("ori $t1, $zero, %lo(matrix_normal)");
        asm("addiu $s0, $s5, -64");
        asm("ori $t0, $zero, 63");
        asm("addiu $t2, $zero, 12");
        asm("jal exec");
        asm("ori $s4, $zero, %lo(clipping_buffer_result)");
        asm("ori $s3, $zero, %lo(clipping_buffer_result)");
        asm("ori $s4, $zero, %lo(matrix_mv)");
        asm("jal multiplyMatrices");
        asm("ori $s2, $zero, %lo(matrix_mv)");
        asm("geometry_matrix_ready:");
        asm("ori $t0, $zero, 63");
        asm("addiu $t2, $zero, -32756");
        asm("jal exec");
        asm("or $s0, $zero, $s5");
        asm("jal normalizeMatrixVector");
        asm("ori $s2, $zero, %lo(matrix_mvp)");
        asm("jal normalizeMatrixVector");
        asm("ori $s3, $zero, %lo(matrix_projection)");
        asm("jal normalizeMatrixVector");
        asm("nop");
        asm("ori $ra, $zero, %lo(commandLoop)");
        asm("j multiplyMatrices");
        asm("ori $s4, $zero, %lo(matrix_mv)");
    }
}

@rspq.command(3) fn setWord(
    reg($a0) address: dmem,
    reg($a1) value: u32,
) noreturn {
    reg($s7) is_halfword: u32;
    is_halfword = address & 0x8000;
    if(is_halfword != 0) tail queue.commandLoop() slot {
        store(u16, address, value);
    }
    tail queue.commandLoop() slot {
        store(u32, address, value);
    }
}

fn triangleClip() noreturn {
    exact {
        asm("geometryTriangleClip:");
        asm("sh $ra, %lo(clipping_return_address)($zero)");
        asm("jal geometry_RDPQ_Triangle_Send_End");
        asm("sh $s4, 0x92($zero)");
        asm("j _start");
        asm("ori $s4, $zero, %lo(_start)");
    }
}

