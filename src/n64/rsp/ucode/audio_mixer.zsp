    reg($v31) vector31: vec16 = undefined;
    exact {
        vector0 = vector0 ^ vector0;
        scratch0 = dmem.addressOf(constants);
        vector31 = load(vec16, scratch0, 0);
        argument0 = argument0 & 65535;
        store(u16, global_volume, argument0);
        scratch1 = argument1 >>> 16;
        store(u16, samples_remaining, scratch1);
        argument1 = argument1 & 65535;
        store(u16, configured_channels, argument1);
        argument2 = load(u32, command_address, 152);
        store(u32, output_rdram, argument2);
        transferSettings() slot { scratch2 = 12; }
        setupMixer(scratch0);
    MainLoop:
        position = load(i16, samples_remaining);
        if (position == 0) goto End slot { scratch1 = load(u32, output_rdram); }
        scratch1 = scratch1 & 7;
        scratch1 = signedLessThan(zero, scratch1);
        sample_count = 32;
        sample_count = sample_count - scratch1;
        comparison = signedLessThan(sample_count, position);
        if (comparison != 0) goto CheckDMAAlignment;
        sample_count = position;
    CheckDMAAlignment:
        if (scratch1 == 0) goto DoLoop slot { output_start = dmem.addressOf(output_buffer); }
        dma_rdram = load(u32, output_rdram);
        dma_dmem = dmem.addressOf(output_buffer);
        dma.in(scratch0, scratch1, dma_rdram, dma_dmem) slot { scratch0 = 7; }
        output_start = output_start + 4;
    DoLoop:
        position = position - sample_count;
        store(u16, samples_remaining, position);
        resampleChannels(scratch0, scratch1) slot { channel_count = load(u16, configured_channels); }
        mixChannels(scratch0, scratch1) slot { dma_dmem = output_start; }
        scratch0 = sample_count << 2;
        dma_rdram = load(u32, output_rdram);
        waveform = dma_rdram + scratch0;
        store(u32, output_rdram, waveform);
        scratch0 = scratch0 + -1;
        dma.outAsync(scratch0, scratch1, dma_rdram, dma_dmem) slot { dma_dmem = dmem.addressOf(output_buffer); }
        goto MainLoop;
    End:
        saveVolumes();
        transferSettings() slot { scratch2 = -32768; }
        dma.waitIdle();
        tail queue.commandLoop();
    }
}

fn transferSettings() {
    reg($t2) scratch2: u32 = undefined;
    reg($t1) scratch1: u32 = undefined;
    reg($at) comparison: u32 = undefined;
    reg($t0) scratch0: dmem = undefined;
    reg($s0) dma_rdram: dmem = undefined;
    reg($s4) dma_dmem: dmem = undefined;
    reg($gp) command_address: dmem = undefined;
    exact {
        dma_rdram = load(u32, command_address, 156);
        dma_dmem = dmem.addressOf(volume_left);
        jump dma.exec(scratch0, scratch1, dma_rdram, dma_dmem, scratch2) slot { scratch0 = 895; }
    }
}

