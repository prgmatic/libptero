packed struct OverlayHeader {
    state_start: u16;
    state_size: u16;
    state_rdram: u32;
    command_base: u16;
    overlay_id: u16;
    text_rdram: u32;
    text_size: u16;
    text_start: u16;
    extra_rdram: u32;
    extra_size: u16;
    extra_start: u16;
}

data {
    overlay_header: OverlayHeader = .{ 0, 0, 0, 0, 0, 0, 0, 0x1800, 0, 0, 0 };
    overlay_commands: [2]u16 = .{ 0x0a00, 0 };
    overlay_value: [4]u32 = .{ 0x4f564c31, 0, 0, 0 };
}

// The resident dispatcher enters at _start with the normal command-handler
// ABI and the handler returns through $ra.
export fn _start(
    reg($a0) command: u32,
) {
    reg dmem_address: u32 = 0;
    dmem_address = command & 0x00ffffff;
    reg value: u32 = load(u32, overlay_value);
    store(u32, dmem_address, value);
}
