const dma = import("dma.zsp");

packed struct OverlaySection {
    rdram_address: u32;
    byte_count: u16;
    dmem_address: u16;
}

// The loaded overlay's header at DMEM 0x1f8: where its persistent state
// lives, the first command index it handles, and its overlay id. Its
// section list follows at 0x204; the last section has bit 31 clear.
packed struct OverlayHeader {
    state_dmem: u16;
    state_size: u16;
    state_rdram: u32;
    command_base: u16;
    overlay_index: u16;
}

data {
    shift_constants: [8]u8 = .{ 0x80, 0x40, 0x20, 0x10, 0x08, 0x04, 0x02, 0x01 };
    overlay_data_rdram: [16]u32;
    overlay_idmap: [16]u8;
    pointer_stack: [10]u32;
    // Scratch shared with overlays, at 0x80. Geometry and its clipping
    // patch keep the strip index pointer and the tile index here.
    pub resident_scratch: [32]u8;
    command_buffer_storage: [256]u8;
    pub rdp_mode: [8]u32;
    pub rdp_scissor_rect: [2]u32;
    pub rdp_buffers: [2]u32;
    pub rdp_current: u32;
    pub rdp_sentinel: u32;
    pub rdp_fill_color: u32;
    queue_rdram_address: u32;
    pub rdp_target_bitdepth: i8;
    pub rdp_syncfull_ongoing: u8;
}

const internal_commands = @rspq.commandTable();


/// Refills the command buffer from the queue position of `$gp`.
fn fetchCommandBuffer() noreturn {
    reg($gp) command_address: dmem = undefined;
    reg rdram: u32 = load(u32, queue_rdram_address);
    rdram = rdram + command_address;
    tail fetchCommandBufferWithPointer(rdram);
}

/// Loads the 256-byte command window starting at the 8-byte-aligned RDRAM
/// address below `rdram`; `$gp` keeps the misalignment. `rdram` arrives in
/// the DMA's address register.
fn fetchCommandBufferWithPointer(reg($s0) rdram: u32) noreturn {
    const command_buffer: dmem = 0xa0;
    reg($gp) command_address: dmem = undefined;
    command_address = rdram & 7;
    rdram = rdram - command_address;
    store(u32, queue_rdram_address, rdram);
    reg pitch: u32 = undefined;
    dma.in(255, pitch, rdram, command_buffer);
    tail commandLoop();
}

// Dispatcher/handler ABI, matching libdragon's RSPQ convention:
//   $gp: address immediately after the current command
//   $a0-$a3: first four command words
//   $t7: command size in bytes
//   $ra: return address in the resident dispatcher
//
// $gp is the only scalar register handlers must preserve.
@rspq.command(0) fn waitForInput() noreturn {
    const status_signal_more: u32 = 0x00004000;
    const status_clear_signal_more: u32 = 0x00800000;

    // Publish the RDP clock (DPC_CLOCK) at which the queue went idle; the
    // CPU pairs it with its wake time to measure RSP busy time. Overlay id 0
    // never maps to an overlay, so its table entry is free. Read the clock
    // before SP_STATUS: the CPU's double wake write only covers a short
    // window between the signal check and the break.
    reg idle_clock: u32 = rsp.cp0.read(12);
    reg more: u32 = rsp.cp0.spStatus();
    more &= status_signal_more;
    store(u32, overlay_data_rdram, idle_clock);
    // With no more work, halt; the CPU restarts the RSP here.
    if (more == 0) {
        rsp.halt();
    }
    rsp.cp0.setSpStatus(status_clear_signal_more);
    tail fetchCommandBuffer();
}

@rspq.command(1) fn writeDmem(
    command: dmem,
    value: u32,
) noreturn {
    store(u32, command, value);
    jump commandLoop();
}

@rspq.command(2) fn jump(command: dmem) noreturn {
    // The low 24 bits are the RDRAM address; the top byte is the opcode.
    reg rdram: u32 = command << 8;
    rdram >>>= 8;
    jump fetchCommandBufferWithPointer(rdram);
}

@rspq.command(3) fn call(
    command: dmem,
    stack_offset: u32,
) noreturn {
    // Save where the queue resumes, then jump. A negative slot means the
    // command word names a DMEM pointer to the jump target.
    reg($gp) command_address: dmem = undefined;
    reg resume_rdram: u32 = load(u32, queue_rdram_address);
    if (stack_offset >= 0x80000000) {
        command = load(u32, command);
    }
    resume_rdram = resume_rdram + command_address;
    store(u32, pointer_stack + stack_offset, resume_rdram);
    tail jump(command);
}

@rspq.command(4) fn returnFromCall(command: dmem) noreturn {
    reg rdram: u32 = load(u32, pointer_stack + command);
    jump fetchCommandBufferWithPointer(rdram);
}

@rspq.command(5) fn runDma(
    rdram_address: u32,
    dmem_address: dmem,
    size: u32,
    flags: u32,
) noreturn {
    // `size` already carries any row count and the pitch is unused. The
    // transfer advances its DMEM address and consumes its flags, so both
    // are passed as copies.
    reg pitch: u32 = undefined;
    reg destination: dmem = dmem_address;
    reg wait_flags: u32 = flags;
    jump dma.exec(size, pitch, rdram_address, destination, wait_flags);
}

@rspq.command(7) fn swapBuffers(
    command: dmem,
    save_slot: u32,
    status: u32,
) noreturn {
    rsp.cp0.setSpStatus(status);
    command = load(u32, pointer_stack + command);
    tail call(command, save_slot);
}

@rspq.command(8) fn waitThenWriteStatus(
    status: u32,
    mask: u32,
) noreturn {
    reg wait_mask: u32 = mask;
    dma.waitStatus(wait_mask);
    tail writeStatus(status);
}

@rspq.command(6) fn writeStatus(status: u32) noreturn {
    rsp.cp0.setSpStatus(status);
    jump commandLoop();
}

// Switches the RDP to the buffer at `start`, then appends up to `current`.
// A zero `sentinel` only records it. The triangle overlay relies on this
// command preserving $t4-$t6; $sp is the resident secondary return-address
// register, since the waits below call through $ra.
@rspq.command(9) pub export fn rdpSetBuffer(
    current: u32,
    start: u32,
    sentinel: u32,
) noreturn {
    const dp_status_dma_busy: u32 = 0x00000100;
    const dp_status_end_valid: u32 = 0x00000200;
    const sp_status_sig0: u32 = 0x80;
    const sp_set_sig0_and_interrupt: u32 = 0x410;

    // The top byte of `current` carries flags.
    current <<= 8;
    current >>>= 8;
    reg($sp) saved_return: u32 = undefined;
    reg($ra) return_address: u32 = undefined;
    store(u32, rdp_sentinel, sentinel);
    reg dp_start: u32 = rsp.cp0.rdpCommandStart();
    if (sentinel == 0) tail dma.returnToCaller();
    saved_return = return_address;

    // Wait until no buffer is pending. During a full sync, also wait for
    // the RDP to go idle; when reusing the current buffer, also wait for its
    // DMA to finish, since new commands will overwrite what it reads.
    reg wait_mask: u32 = load(u8, rdp_syncfull_ongoing);
    if (dp_start == start) {
        wait_mask |= dp_status_dma_busy;
    }
    wait_mask |= dp_status_end_valid;
    // The full sync is over once this wait ends; the flag is cleared while
    // waiting, in the loop's otherwise empty delay slot.
    reg dp_status: u32 = undefined;
    do {
        dp_status = rsp.cp0.rdpStatus();
        dp_status &= wait_mask;
    } while (dp_status != 0) slot {
        store(u8, rdp_syncfull_ongoing, 0);
    }

    // Submit what a pending full sync held back.
    reg bitdepth: i32 = load(i8, rdp_target_bitdepth);
    reg rdp_end: u32 = load(u32, rdp_current);
    rsp.cp0.setRdpCommandEnd(rdp_end);
    if (bitdepth < 0) {
        // The RDP validator is active: interrupt the CPU so it records the
        // new buffer, and wait until it acknowledges through SIG0.
        dma.waitStatus(sp_status_sig0);
        rsp.cp0.setSpStatus(sp_set_sig0_and_interrupt);
        dma.waitStatus(sp_status_sig0);
    }
    return_address = saved_return;
    rsp.cp0.setRdpCommandStart(start);
    tail rdpAppendBuffer(current);
}

@rspq.command(10) pub export fn rdpAppendBuffer(current: u32) noreturn {
    reg($ra) return_address: u32 = undefined;
    reg syncfull_ongoing: u32 = load(u8, rdp_syncfull_ongoing);
    if(syncfull_ongoing != 0) tail dma.returnToCaller() slot {
        store(u32, rdp_current, current);
    }
    rsp.cp0.setRdpCommandEnd(current);
    jump(return_address);
}

// Resident command queue dispatcher.
export fn _start() noreturn {
    reg($gp) command_address: dmem = 0;
    tail waitForInput();
}

pub export fn commandLoop() noreturn {
    const command_buffer: u32 = 0xa0;
    const command_buffer_size: u32 = 256;
    const overlay_idmap_address: u32 = 0x48;
    const overlay_command_table: u32 = 0x214;
    const overlay_header: dmem = 0x1f8;
    const status_high_priority_requested: u32 = 0x00000800;
    const status_high_priority_mask: u32 = 0x00000c00;
    const status_enter_high_priority: u32 = 0x00030000;

    // Handler ABI: the command words, its size, the next command, the
    // return address, and the vector constants every handler may use.
    reg($gp) command_address: dmem = undefined;
    reg($a0) command_header: u32 = undefined;
    reg($a1) argument_1: u32 = undefined;
    reg($a2) argument_2: u32 = undefined;
    reg($a3) argument_3: u32 = undefined;
    reg($t7) command_size: u32 = undefined;
    reg($v31) shift_vector: vec16 = undefined;
    reg($v30) shifted_vector: vec16 = undefined;
    reg($v00) vector_zero: vec16 = undefined;

    reg priority: u32 = rsp.cp0.spStatus();
    command_header = load(u32, command_buffer + command_address);
    priority &= status_high_priority_mask;
    if (priority == status_high_priority_requested) {
        tail swapBuffers(36, 32, status_enter_high_priority);
    }

    // The top four bits select an overlay; 0 is the resident table.
    reg overlay_id: u32 = command_header >> 28;
    reg command_offset: u32 = command_header >> 23;
    command_offset &= 0x01fe;
    reg descriptor: u32 = load(u16, internal_commands + command_offset);
    if (overlay_id != 0) {
        // Look the command up as if its overlay were loaded; if it is not,
        // load it and dispatch the command again. Overlay handlers may rely
        // on the shift constants and a zero vector.
        shift_vector = loadVectorBytes(0);
        reg overlay_index: u32 = load(u8, overlay_idmap_address + overlay_id);
        reg loaded_index: u32 = load(OverlayHeader.overlay_index, overlay_header);
        reg command_base: u32 = load(OverlayHeader.command_base, overlay_header);
        command_offset -= command_base;
        descriptor = load(u16, overlay_command_table + command_offset);
        shifted_vector = shift_vector >>> 8;
        vector_zero = 0;
        if (overlay_index != loaded_index) tail loadOverlay(overlay_index);
    }

    argument_1 = load(u32, command_buffer + command_address, 4);
    argument_2 = load(u32, command_buffer + command_address, 8);
    argument_3 = load(u32, command_buffer + command_address, 12);
    if (descriptor == 0) tail invalidCommand(0xff020000);

    // Bits 8-15 of the descriptor hold the command size in bytes.
    command_size = descriptor >> 8;
    command_size &= 0xfc;
    reg command_end: u32 = command_address +% command_size;
    reg fits: u32 = signedLessThan(command_end, command_buffer_size);
    if (fits == 0) tail fetchCommandBuffer();
    command_address = command_address + command_size;
    descriptor <<= 2;
    reg($ra) return_address: fn() = &commandLoop;
    jump(descriptor);
}

/// Saves the loaded overlay's state, loads overlay `overlay_index` (its
/// header first, then each section it lists), and dispatches the pending
/// command again.
fn loadOverlay(overlay_index: u32) noreturn {
    const overlay_header: dmem = 0x1f8;
    const overlay_sections: dmem = 0x204;
    // Single-row transfers ignore the pitch.
    reg pitch: u32 = undefined;

    reg state_size: u32 = load(OverlayHeader.state_size, overlay_header);
    reg state_rdram: u32 = load(OverlayHeader.state_rdram, overlay_header);
    reg state_dmem: dmem = load(OverlayHeader.state_dmem, overlay_header);
    dma.outAsync(state_size, pitch, state_rdram, state_dmem);
    if (overlay_index == 0) tail invalidCommand(0xff010000);

    // The overlay's RDRAM word holds the header length in its top bits.
    reg header_rdram: u32 = load(u32, overlay_data_rdram + overlay_index);
    reg header_size: u32 = header_rdram >> 20;
    header_size |= 0x0f;
    reg header_dmem: dmem = overlay_header;
    dma.in(header_size, pitch, header_rdram, header_dmem);

    reg section: *OverlaySection = overlay_sections;
    reg section_rdram: u32 = undefined;
    do {
        section_rdram = section.rdram_address;
        reg section_size: u32 = section.byte_count;
        reg section_dmem: dmem = section.dmem_address;
        dma.in(section_size, pitch, section_rdram, section_dmem);
        section += sizeOf(OverlaySection);
    } while (section_rdram >= 0x80000000);
    tail commandLoop();
}

// Records `assertion_code` for the CPU's crash report and halts.
pub export fn invalidCommand(reg($at) assertion_code: u32) noreturn {
    store(u32, resident_scratch, assertion_code);
    rsp.halt(0xba);
}
