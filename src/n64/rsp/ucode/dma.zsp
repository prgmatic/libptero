// Stackless DMA ABI, matching libdragon's rsp_dma.inc:
//   $t0: DMA size descriptor
//   $t1: RDRAM pitch
//   $s0: RDRAM address
//   $s4: DMEM address
//   $t2: operation flags
//
// Returns through $ra. Clobbers $t2 and $t3. For DMA reads, $s4 is adjusted
// by the low three bits of the RDRAM address.
pub export fn out(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: dmem,
) noreturn {
    reg($t2) flags: u32 = -32756;
    jump exec(size, pitch, rdram, dmem, flags);
}

pub fn outAsync(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: dmem,
) noreturn {
    reg($t2) flags: u32 = -32768;
    jump exec(size, pitch, rdram, dmem, flags);
}

pub fn inAsync(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: dmem,
) noreturn {
    reg($t2) flags: u32 = 0;
    jump exec(size, pitch, rdram, dmem, flags);
}

pub export fn in(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: dmem,
) noreturn {
    reg($t2) flags: u32 = 0x0c;
    tail exec(size, pitch, rdram, dmem, flags);
}

pub export fn exec(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: dmem,
    reg($t2) flags: u32,
) noreturn {
    reg dma_full: u32;
    reg transfer_descriptor: u32;
    do {
        dma_full = rsp.cp0.dmaFull();
    } while(dma_full != 0) slot {
        transfer_descriptor = size & 0x0fff;
    }
    transfer_descriptor = pitch - transfer_descriptor;
    transfer_descriptor -= 1;
    transfer_descriptor <<= 20;
    transfer_descriptor |= size;
    rsp.cp0.setDmaRdramAddress(rdram);
    rsp.cp0.setDmaMemoryAddress(dmem);
    if(flags < 0x80000000) {
        rsp.cp0.startDmaRead(transfer_descriptor);
    } else {
        rsp.cp0.startDmaWrite(transfer_descriptor);
    }
    reg rdram_alignment: u32;
    rdram_alignment = rdram & 7;
    dmem = dmem + rdram_alignment;
    flags &= 0x0f;
    jump waitStatus(flags);
}

pub export fn waitStatus(reg($t2) flags: u32) noreturn {
    reg status: u32;
    status = rsp.cp0.spStatus();
    do {
        status &= flags;
    } while(status != 0) slot {
        status = rsp.cp0.spStatus();
    }
    tail returnToCaller();
}

pub export fn returnToCaller() noreturn {
    reg($ra) return_address: u32 = undefined;
    jump(return_address);
}

pub fn waitIdle() noreturn {
    reg($t2) flags: u32 = 0x0c;
    jump waitStatus(flags);
}

pub export fn waitOut() noreturn {
    reg($t2) flags: u32 = 0x08;
    tail waitStatus(flags);
}
