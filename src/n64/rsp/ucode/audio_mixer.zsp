    banner1: [16]u8 = .{ 32, 67, 111, 100, 101, 100, 32, 98, 121, 32, 82, 97, 115, 107, 121, 32 };
    identity: [8]u16 = .{ 2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048 };
}
