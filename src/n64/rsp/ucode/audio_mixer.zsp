    reg($v23) vector23: vec16 = undefined;
    reg($v24) vector24: vec16 = undefined;
    reg($v25) vector25: vec16 = undefined;
    reg($v26) vector26: vec16 = undefined;
    reg($v27) vector27: vec16 = undefined;
    reg($v28) vector28: vec16 = undefined;
    exact {
        scratch0 = load(i16, global_volume);
        vector1[0] = scratch0;
        vector1 = vector0 | vector1.xxxxxxxx;
        dma_rdram = dmem.addressOf(volume_left);
        waveform = dmem.addressOf(current_volume_left);
        vector21 = load(vec16, dma_rdram, 0);
        vector23 = load(vec16, dma_rdram, 16);
        vector25 = load(vec16, dma_rdram, 32);
        vector27 = load(vec16, dma_rdram, 48);
        vector22 = load(vec16, dma_rdram, 64);
        vector24 = load(vec16, dma_rdram, 80);
        vector26 = load(vec16, dma_rdram, 96);
        vector28 = load(vec16, dma_rdram, 112);
        vector21 = vmudl(vector21, vector1);
        vector22 = vmudl(vector22, vector1);
        vector23 = vmudl(vector23, vector1);
        vector24 = vmudl(vector24, vector1);
        vector25 = vmudl(vector25, vector1);
        vector26 = vmudl(vector26, vector1);
        vector27 = vmudl(vector27, vector1);
        vector28 = vmudl(vector28, vector1);
        vector13 = load(vec16, waveform, 0);
