const cp0 = @import("cp0.zsp");

// Stackless DMA ABI, matching libdragon's rsp_dma.inc:
//   $t0: DMA size descriptor
//   $t1: RDRAM pitch
//   $s0: RDRAM address
//   $s4: DMEM address
//   $t2: operation flags
//
// Returns through $ra. Clobbers $t2 and $t3. For DMA reads, $s4 is adjusted
// by the low three bits of the RDRAM address.
pub fn out(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: u32,
) noreturn {
    reg($t2) flags: u32 = -32756;
    @goto(exec);
}

pub fn outAsync(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: u32,
) noreturn {
    reg($t2) flags: u32 = -32768;
    @goto(exec);
}

pub fn inAsync(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: u32,
) noreturn {
    reg($t2) flags: u32 = 0;
    @goto(exec);
}

pub fn in(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: u32,
) noreturn {
    reg($t2) flags: u32 = 0x0c;
}

pub fn exec(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: u32,
    reg($t2) flags: u32,
) noreturn {
    reg scratch: u32 = undefined;
dma_exec_wait:
    cp0.getDmaFullAt(scratch);
    if(scratch != 0) goto dma_exec_wait delay {
        scratch = size & 0x0fff;
    }
    scratch = pitch - scratch;
    scratch -= 1;
    scratch <<= 20;
    scratch |= size;
    cp0.setDmaAddrRdram(rdram);
    if(flags < 0x80000000) goto dma_exec_read delay {
        cp0.setDmaAddrRsp(dmem);
    }
    goto dma_exec_done, .branch delay {
        cp0.setDmaWriteAt(scratch);
    }
dma_exec_read:
    cp0.setDmaReadAt(scratch);
dma_exec_done:
    scratch = rdram & 7;
    dmem = dmem + scratch;
    flags &= 0x0f;
    @fallthrough(waitStatus);
}

pub fn waitStatus(reg($t2) flags: u32) noreturn {
    reg status: u32 = undefined;
    cp0.getSpStatusAt(status);
dma_status_wait:
    status &= flags;
    if(status != 0) goto dma_status_wait delay {
        cp0.getSpStatusAt(status);
    }
    @fallthrough(returnToCaller);
}

pub fn returnToCaller() noreturn {
    reg($ra) return_address: u32 = undefined;
    @jump(return_address);
}

pub fn waitIdle() noreturn {
    reg($t2) flags: u32 = 0x0c;
    @goto(waitStatus);
}

pub fn waitOut() noreturn {
    reg($t2) flags: u32 = 0x08;
    @goto(waitStatus);
}
