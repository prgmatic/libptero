// Point lights and the spherical texture effect for the geometry overlay's
// vertex loop. Both run out of line, as cold paths.
const math = import("geometry_math.zsp");

// A point light's fields, relative to its record.
const light_point_position: u32 = 8;
const light_point_size: u32 = 14;

/// `position` is overwritten, and products accumulate through `scratch`.
pub inline fn pointLight(
    point: dmem,
    matrix_mv: dmem,
    light_scale: vec16,
    eye_position: vec32,
    sum: vec32,
    to_light: vec32,
    square: vec32,
    position: vec16,
    normal: vec16,
    eye_position_ready: u32,
    scratch: vec16,
    vector_zero: vec16,
    powers: vec16,
    shifts: vec16,
) {
    reg size: u32 = load(u16, point, light_point_size);
    if (eye_position_ready == 0) {
        math.loadMatrix(eye_position, sum, to_light, square, matrix_mv);
        scratch = vmudn(eye_position.sfract, position.xxxxXXXX);
        scratch = vmadh(eye_position.sint, position.xxxxXXXX);
        scratch = vmadn(sum.sfract, position.yyyyYYYY);
        scratch = vmadh(sum.sint, position.yyyyYYYY);
        scratch = vmadn(to_light.sfract, position.zzzzZZZZ);
        scratch = vmadh(to_light.sint, position.zzzzZZZZ);
        eye_position.sfract = vmadn(square.sfract, powers.WWWWWWWW);
        eye_position.sint = vmadh(square.sint, powers.WWWWWWWW);
        // Down to the light positions' scale.
        eye_position.sfract = vmudl(eye_position.sfract, shifts.wwwwwwww);
        eye_position.sint = vmadm(eye_position.sint, shifts.wwwwwwww);
        eye_position.sfract = vmadn(vector_zero, vector_zero);
        eye_position_ready = 1;
    }
    // The top bit of the size ignores the normal.
    reg ignore_normal: u32 = size >> 15;
    size &= 0x7fff;

    // The vector from the vertex to the light, its length, and the size
    // as 16.16 in W.
    to_light.sint[0..4] = load(vec16, point, light_point_position);
    to_light.sint[4..8] = load(vec16, point, light_point_position);
    to_light.sint = vmudm(to_light.sint, shifts.YYYYYYYY);
    to_light.sfract = vmadn(vector_zero, vector_zero);
    to_light = to_light - eye_position;
    scratch = vmudl(to_light.sfract, to_light.sfract);
    scratch = vmadm(to_light.sint, to_light.sfract);
    square.sfract = vmadn(to_light.sfract, to_light.sint);
    square.sint = vmadh(to_light.sint, to_light.sint);
    sum = square + square.yyyyYYYY;
    square += sum.zzzzZZZZ;
    sum.sint[3] = size;
    sum.sfract[3] = vector_zero[0];

    // 1/length of both vectors, then size/length as the falloff.
    square.sint[0] = vrsqh(square.sint[0]);
    square.sfract[0] = vrsql(square.sfract[0]);
    square.sint[0] = vrsqh(square.sint[4]);
    square.sfract[4] = vrsql(square.sfract[4]);
    square.sint[4] = vrsqh(vector_zero[0]);
    scratch = vmudl(square.sfract, sum.sfract.wwwwwwww);
    scratch = vmadm(square.sint, sum.sfract.wwwwwwww);
    scratch = vmadn(square.sfract, sum.sint.wwwwwwww);
    light_scale = vmadh(square.sint, sum.sint.wwwwwwww);
    light_scale = vmulf(light_scale, light_scale);
    if (ignore_normal == 0) {
        // The normalized direction times the squared falloff, dotted with
        // the normal by the caller. The extra shift moves the fraction
        // into the integer so the product does not clamp.
        square = square * shifts.WWWWWWWW;
        scratch = vmudl(to_light.sfract, square.sfract.xxxxXXXX);
        scratch = vmadm(to_light.sint, square.sfract.xxxxXXXX);
        scratch = vmadn(to_light.sfract, square.sint.xxxxXXXX);
        position = vmadh(to_light.sint, square.sint.xxxxXXXX);
        position = vmulf(position, light_scale.xxxxXXXX);
        light_scale = vmulf(position, normal);
    } else {
        // Size only: the caller's dot product sees just X.
        light_scale[1] = vector_zero[0];
        light_scale[2] = vector_zero[0];
        light_scale[5] = vector_zero[0];
        light_scale[6] = vector_zero[0];
    }
}

/// Spherical environment mapping: texture coordinates from the normal,
/// offset by the vertex's distance from the screen center so the
/// reflection follows the view. Both vertices' S T end up in lanes 0-3.
pub inline fn sphericalTexture(
    texture: vec16,
    screen: vec16,
    screen_offset: vec16,
    normal: vec16,
    uv_generation: vec16,
    vector_zero: vec16,
) {
    reg offset: vec16 = vge(screen, vector_zero.xxxxxxxx);
    offset = vsubc(offset, screen_offset);
    offset = vlt(offset, screen_offset);
    texture = vmulf(normal, uv_generation);
    // Undo the screen projection into a normalized factor, fade it as the
    // normal turns from the camera, and scale it to the texture.
    offset = vmudn(offset, uv_generation.WWWWWWWW);
    offset = vmulf(offset, normal.zzzzZZZZ);
    offset = vmulf(offset, uv_generation.xxxxxxxx);
    texture = vaddc(texture, uv_generation.xxxxxxxx);
    texture = vaddc(texture, offset);
    // The second vertex's S T into lanes 2-3, where the caller stores it.
    texture[2] = texture[4];
    texture[3] = texture[5];
}
