const dma = import("dma.zsp");

packed struct OverlaySection {
    rdram_address: u32;
    byte_count: u16;
    dmem_address: u16;
}

data {
    shift_constants: [8]u8 = .{ 0x80, 0x40, 0x20, 0x10, 0x08, 0x04, 0x02, 0x01 };
    overlay_data_rdram: [16]u32;
    overlay_idmap: [16]u8;
    pointer_stack: [10]u32;
    queue_rdram_address: u32;
    resident_scratch: [27]u8;
    pub rdp_publication_held: u8;
    command_buffer_storage: [256]u8;
    pub rdp_mode: [8]u32;
    pub rdp_scissor_rect: [2]u32;
    pub rdp_buffers: [2]u32;
    pub rdp_current: u32;
    pub rdp_sentinel: u32;
    pub rdp_fill_color: u32;
    pub rdp_target_bitdepth: i8;
    pub rdp_syncfull_ongoing: u8;
}

const internal_commands = @rspq.commandTable();


fn fetchCommandBuffer() noreturn {
    reg($s0) rdram: u32 = load(u32, queue_rdram_address);
    reg($gp) command_address: dmem = undefined;
    rdram = rdram + command_address;
    tail fetchCommandBufferWithPointer(rdram);
}

fn fetchCommandBufferWithPointer(
    reg($s0) rdram: u32,
) noreturn {
    const command_buffer: u32 = 0xa0;
    reg($s4) dma_destination: dmem = command_buffer;
    reg($gp) command_address: dmem = undefined;
    command_address = rdram & 7;
    rdram = rdram - command_address;
    store(u32, queue_rdram_address, rdram);
    reg($t0) dma_size: u32 = 255;
    reg($t1) dma_pitch: u32 = undefined;
    dma.in(dma_size, dma_pitch, rdram, dma_destination);
    tail commandLoop();
}

// Dispatcher/handler ABI, matching libdragon's RSPQ convention:
//   $gp: address immediately after the current command
//   $a0-$a3: first four command words
//   $t7: command size in bytes
//   $ra: return address in the resident dispatcher
//
// $gp is the only scalar register handlers must preserve.
@rspq.command(0) fn waitForInput() noreturn {
    const status_signal_more: u32 = 0x00004000;
    const status_clear_signal_more: u32 = 0x00800000;

    reg status_value: u32;
    status_value = rsp.cp0.spStatus();
    status_value &= status_signal_more;
    if(status_value == 0) slot {
        status_value = status_clear_signal_more;
    } {
        rsp.halt();
    }
    rsp.cp0.setSpStatus(status_value);

    tail fetchCommandBuffer();
}

@rspq.command(1) fn writeDmem(
    command: dmem,
    value: u32,
) noreturn {
    store(u32, command, value);
    jump commandLoop();
}

@rspq.command(2) fn jump(command: dmem) noreturn {
    reg($s0) rdram: u32 = undefined;
    rdram = command;
    jump fetchCommandBufferWithPointer(rdram);
}

@rspq.command(3) fn call(
    command: dmem,
    stack_offset: u32,
) noreturn {
    reg($s0) return_address: u32 = load(u32, queue_rdram_address);
    reg($gp) command_address: dmem = undefined;
    if(stack_offset >= 0x80000000) {
        command = load(u32, command);
    }
    return_address = return_address + command_address;
    store(u32, stack_offset, return_address, pointer_stack);
    tail jump(command);
}

@rspq.command(4) fn returnFromCall(command: dmem) noreturn {
    reg($s0) rdram: u32 = load(u32, command, pointer_stack);
    jump fetchCommandBufferWithPointer(rdram);
}

@rspq.command(5) fn runDma(
    rdram_address: u32,
    dmem_address: dmem,
    size: u32,
    flags: u32,
) noreturn {
    reg rdram: u32 = undefined;
    reg dma_size: u32 = undefined;
    reg($t1) dma_pitch: u32 = undefined;
    reg($s4) dma_destination: dmem = undefined;
    reg($t2) dma_flags: u32 = undefined;
    rdram = rdram_address;
    dma_destination = dmem_address;
    dma_size = size;
    dma_flags = flags;
    jump dma.exec(dma_size, dma_pitch, rdram, dma_destination, dma_flags);
}

@rspq.command(7) fn swapBuffers(
    command: dmem,
    save_slot: u32,
    status: u32,
) noreturn {
    rsp.cp0.setSpStatus(status);
    command = load(u32, command, pointer_stack);
    tail call(command, save_slot);
}

@rspq.command(8) fn waitThenWriteStatus(
    status: u32,
    mask: u32,
) noreturn {
    reg wait_mask: u32 = mask;
    dma.waitStatus(wait_mask);
}

@rspq.command(6) fn writeStatus(status: u32) noreturn {
    rsp.cp0.setSpStatus(status);
    jump commandLoop();
}

@rspq.command(9) pub export fn rdpSetBuffer(
    current: u32,
    start: u32,
    sentinel: u32,
) noreturn {
    current <<= 8;
    current >>>= 8;
    reg dp_value: u32;
    reg masked_status: u32;
    reg dp_status: u32;
    reg wait_mask: u32;
    reg saved_return: u32;
    reg($ra) return_address: u32 = undefined;
    store(u32, rdp_sentinel, sentinel);
    if(sentinel == 0) tail dma.returnToCaller() slot {
        dp_value = rsp.cp0.rdpCommandStart();
    }
    saved_return = return_address;
    const dp_status_end_valid: u32 = 0x00000200;
    const dp_status_dma_busy: u32 = 0x00000100;

    wait_mask = load(u8, rdp_syncfull_ongoing);
    if(dp_value == start) {
        wait_mask |= dp_status_dma_busy;
    }
    wait_mask |= dp_status_end_valid;
    do {
        dp_status = rsp.cp0.rdpStatus();
        masked_status = dp_status & wait_mask;
        store(u8, rdp_syncfull_ongoing, 0);
    } while(masked_status != 0);
    dp_value = load(u32, rdp_current);
    dp_status = load(i8, rdp_target_bitdepth);
    rsp.cp0.setRdpCommandEnd(dp_value);
    if(dp_status >= 0x80000000) {
        dp_status = 0x80;
        dma.waitStatus(dp_status);
        dp_value = 0x410;
        rsp.cp0.setSpStatus(dp_value);
        dp_status = 0x80;
        dma.waitStatus(dp_status);
    }
    return_address = saved_return;
    rsp.cp0.setRdpCommandStart(start);
    tail rdpAppendBuffer(current);
}

@rspq.command(10) pub export fn rdpAppendBuffer(current: u32) noreturn {
    reg($ra) return_address: u32 = undefined;
    reg syncfull_ongoing: u32 = load(u8, rdp_syncfull_ongoing);
    reg publication_held: u32 = load(u8, rdp_publication_held);
    syncfull_ongoing |= publication_held;
    if(syncfull_ongoing != 0) tail dma.returnToCaller() slot {
        store(u32, rdp_current, current);
    }
    rsp.cp0.setRdpCommandEnd(current);
    jump(return_address);
}

@rspq.command(11) fn rdpReleaseBuffer() noreturn {
    reg current: u32 = load(u32, rdp_current);
    store(u8, rdp_publication_held, 0);
    rsp.cp0.setRdpCommandEnd(current);
    jump commandLoop();
}

@rspq.command(12) fn rdpBeginBatch(reg($a0) _: u32, reg($a1) _: u32) noreturn {
    reg wait_mask: u32 = 0x00000300;
    dma.waitStatus(wait_mask);
    reg held: u32 = 1;
    store(u8, rdp_syncfull_ongoing, 0);
    store(u8, rdp_publication_held, held);
    jump commandLoop();
}

// Resident command queue dispatcher.
export fn _start() noreturn {
    reg($gp) command_address: dmem = 0;
    tail waitForInput();
}

pub export fn commandLoop() noreturn {
    const command_buffer: u32 = 0xa0;
    const command_buffer_size: u32 = 256;
    const overlay_idmap_address: u32 = 0x48;
    const overlay_command_table: u32 = 0x214;
    const status_high_priority_requested: u32 = 0x00000800;
    const status_high_priority_mask: u32 = 0x00000c00;
    const status_enter_high_priority: u32 = 0x00030000;

    reg($gp) command_address: dmem = undefined;
    reg($a0) command_header: u32 = undefined;
    reg($a1) argument_1: u32 = undefined;
    reg($a2) argument_2: u32 = undefined;
    reg($a3) argument_3: u32 = undefined;
    reg($t0) dma_size: u32 = undefined;
    reg($t1) dma_pitch: dmem = undefined;
    reg($t2) dma_flags: u32 = undefined;
    reg($t4) overlay_index: dmem = undefined;
    reg($t5) command_index: u32 = undefined;
    reg($t6) command_descriptor: u32 = undefined;
    reg($t7) command_size: u32 = undefined;
    reg($s0) rdram: u32 = undefined;
    reg($s4) dma_destination: dmem = undefined;
    reg($v31) shift_vector: vec16 = undefined;
    reg($v30) shifted_vector: vec16 = undefined;
    reg($v00) vector_zero: vec16 = undefined;
switch_high_priority: block {
    dma_flags = rsp.cp0.spStatus();
    command_header = load(u32, command_address, command_buffer);
    dma_size = status_high_priority_requested;
    dma_flags &= status_high_priority_mask;
    command_size = command_header >> 28;
    if(dma_flags == dma_size) {
        break switch_high_priority;
    }

    command_index = command_header >> 23;
    command_index &= 0x01fe;
    execute_command: block {
        command_descriptor = load(u16, command_index, internal_commands);
        if(command_size == 0) {
            break execute_command;
        }

    resolve_overlay: do {
        dma_pitch = load(u16, 0, 0x202);
        overlay_index = load(u8, command_size, overlay_idmap_address);
        dma_size = load(u16, 0, 0x200);
        shift_vector = loadVectorBytes(0);
        command_index = command_index - dma_size;
        if(overlay_index == dma_pitch) {
            break resolve_overlay;
        }

        command_index +%= dma_size;

        dma_size = load(u16, 0, 0x1fa);
        rdram = load(u32, 0, 0x1fc);
        dma_destination = load(u16, 0, 0x1f8);
        dma.outAsync(dma_size, dma_pitch, rdram, dma_destination);
        if(overlay_index == 0) tail invalidCommand() slot {
            reg($at) assertion_code: u32 = 0xff010000;
        }

        rdram = load(u32, overlay_index, overlay_data_rdram);
        dma_destination = 0x1f8;
        dma_pitch = 0x204;
        dma_size = rdram >> 20;
        dma_size |= 0x0f;
        dma.in(dma_size, dma_pitch, rdram, dma_destination);

        do {
            rdram = load(OverlaySection.rdram_address, dma_pitch);
            dma_size = load(OverlaySection.byte_count, dma_pitch);
            dma_destination = load(OverlaySection.dmem_address, dma_pitch);
            dma.in(dma_size, dma_pitch, rdram, dma_destination);
            dma_pitch +%= 8;
        } while(rdram >= 0x80000000);
        argument_2 = status_enter_high_priority;
    } while(overlay_index != dma_pitch);
        command_descriptor = load(u16, command_index, overlay_command_table);
    }

    argument_1 = load(u32, command_address, 0xa4);
    shifted_vector = shift_vector >>> 8;
    dma_pitch = command_buffer_size;
    if(command_descriptor == 0) tail invalidCommand() slot {
        reg($at) assertion_code: u32 = 0xff020000;
    }
    command_size = command_descriptor >> 8;
    vector_zero = 0;
    command_size &= 0xfc;
    dma_size = command_address +% command_size;
    reg($at) command_fits_buffer: u32 = undefined;
    command_fits_buffer = signedLessThan(dma_size, dma_pitch);
    if(command_fits_buffer == 0) tail fetchCommandBuffer() slot {
        argument_2 = load(u32, command_address, 0xa8);
    }
    argument_3 = load(u32, command_address, 0xac);
    command_address = command_address + command_size;
    command_descriptor <<= 2;
    reg($ra) return_address: fn() = &commandLoop;
    jump(command_descriptor);

} exit slot {
        argument_2 = status_enter_high_priority;
}
    command_header = 36;
    argument_1 = 32;
    tail swapBuffers(command_header, argument_1, argument_2);
}

pub export fn invalidCommand() noreturn {
    reg($at) assertion_code: u32 = undefined;
    store(u32, resident_scratch, assertion_code);
    rsp.halt(0xba);
}
