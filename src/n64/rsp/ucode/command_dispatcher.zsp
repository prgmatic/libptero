const dma = @import("dma.zsp");

data {
    shift_constants: [8]u8 = .{ 0x80, 0x40, 0x20, 0x10, 0x08, 0x04, 0x02, 0x01 };
}

// Resident queue state is addressable DMEM, but is not part of the ucode image.
bss {
    overlay_data_rdram: [16]u32;
    overlay_idmap: [16]u8;

    queue_rdram_address: u32;
    command_status: u32;
    current_overlay_id: u32;
    overlay_load_count: u32;
}

fn dispatch(reg($t6) handler_address: u32) noreturn {
    @jump(handler_address);
}

// Dispatcher/handler ABI, matching libdragon's RSPQ convention:
//   $gp: address immediately after the current command
//   $a0-$a3: first four command words
//   $t7: command size in bytes
//   $ra: return address in the resident dispatcher
//
// $gp is the only scalar register handlers must preserve.
fn write_dmem(
    reg($a0) command: u32,
    reg($a1) value: u32,
) {
    reg dmem_address: u32 = 0;
    dmem_address = command & 0x00ffffff;
    store(u32, dmem_address, value);
}

// Resident command queue dispatcher.
export fn _start() noreturn {
    const command_buffer: u32 = 0xa0;
    const overlay_table_address: u32 = 0x08;
    const overlay_idmap_address: u32 = 0x48;

    reg($s0) rdram: u32 = load(u32, queue_rdram_address);
    reg($t0) dma_size: u32 = 31;
    reg($t1) dma_pitch: u32 = 0;
    reg($s4) dma_destination: u32 = command_buffer;
    reg($t2) dma_flags: u32 = 0x0c;
    dma.exec(dma_size, dma_pitch, rdram, dma_destination, dma_flags);

    store(u32, command_status, 0);

    reg($gp) command_address: u32 = command_buffer;
    reg($a0) command_header: u32 = load(u32, command_address);
    reg($a1) argument_1: u32 = 0;
    reg($a2) argument_2: u32 = 0;
    reg($a3) argument_3: u32 = 0;
    reg($t7) command_size: u32 = 0;
    reg($t6) handler_address: u32 = 0;
    reg command_id: u32 = 0;
    command_id = command_header >> 24;

    while(command_id != 0) {
        command_size = 8;
        argument_1 = load(u32, command_address, 4);
        argument_2 = load(u32, command_address, 8);
        argument_3 = load(u32, command_address, 12);
        if(command_id == 1) {
            command_address += command_size;
            write_dmem(command_header, argument_1);
        } else {
            handler_address = command_id >> 4;
            rdram = overlay_idmap_address;
            dma_size = handler_address & 0xfffffffc;
            rdram += dma_size;
            dma_size = load(u32, rdram);
            dma_pitch = 3;
            dma_destination = handler_address & 3;
            dma_pitch -= dma_destination;
            dma_pitch = dma_pitch << 3;
            dma_size = dma_size >> dma_pitch;
            handler_address = dma_size & 0xff;

            if(handler_address != 0) {
                reg current_overlay: u32 = load(u32, current_overlay_id);
                if(current_overlay != handler_address) {
                    rdram = overlay_table_address;
                    rdram += handler_address;
                    dma_destination = load(u32, rdram);
                    rdram = dma_destination & 0x00ffffff;
                    dma_size = dma_destination >> 24;
                    dma_size = dma_size << 4;
                    dma_size = dma_size | 15;
                    dma_destination = 0x800;
                    dma_pitch = 0;
                    dma_flags = 0x0c;
                    dma.exec(dma_size, dma_pitch, rdram, dma_destination, dma_flags);

                    rdram = load(u32, 0x80c);
                    dma_destination = load(u32, 0x810);
                    dma_size = dma_destination >> 16;
                    dma_destination = dma_destination & 0xffff;
                    dma_pitch = 0;
                    dma_flags = 0x0c;
                    dma.exec(dma_size, dma_pitch, rdram, dma_destination, dma_flags);

                    current_overlay = load(u32, overlay_load_count);
                    current_overlay += 1;
                    store(u32, overlay_load_count, current_overlay);
                    store(u32, current_overlay_id, handler_address);
                }

                // dma.exec uses $t3 internally, so restore the decoded command.
                command_id = command_header >> 24;
                dma_size = load(u32, 0x808);
                dma_size = dma_size >> 16;
                rdram = 0x81c;
                dma_pitch = command_id << 1;
                dma_pitch -= dma_size;
                rdram += dma_pitch;
                dma_destination = rdram & 2;
                rdram = rdram & 0xfffffffc;
                dma_size = load(u32, rdram);
                dma_pitch = 2;
                dma_pitch -= dma_destination;
                dma_pitch = dma_pitch << 3;
                dma_size = dma_size >> dma_pitch;
                dma_size = dma_size & 0xffff;
                command_size = dma_size >> 8;
                handler_address = dma_size & 0x07ff;
                handler_address = handler_address << 2;
                handler_address += 0x1000;
                command_address += command_size;
                dispatch(handler_address);
            } else {
                store(u32, command_status, command_id);
                @break();
            }
        }

        command_header = load(u32, command_address);
        command_id = command_header >> 24;
    }

    @break();
}
