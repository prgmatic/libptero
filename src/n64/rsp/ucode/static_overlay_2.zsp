data {
    overlay_value: [4]u32 = .{ 0x4f564c32, 0, 0, 0 };
}

// Both overlays expose the same command ABI and link at the same replaceable
// IMEM/DMEM addresses. Their payload makes the active overlay observable.
command(0) fn _start(
    reg($a0) command: u32,
) {
    reg dmem_address: u32 = 0;
    dmem_address = command & 0x00ffffff;
    reg value: u32 = load(u32, overlay_value);
    store(u32, dmem_address, value);
}
