// Stackless DMA ABI used by the resident queue and every overlay:
//   $t0: DMA size descriptor (length - 1, optionally with a row count)
//   $t1: RDRAM pitch
//   $s0: RDRAM address
//   $s4: DMEM address
//   $t2: operation flags
//
// Returns through $ra and writes only $at, $t2, and $s4, so callers keep
// everything else live across a transfer; $at is the only scratch register.
// For DMA reads, $s4 is advanced by the low three bits of the RDRAM address
// so it points at the requested byte.

// Bit 31 selects an RDRAM write; the low bits are SP status bits to wait on.
const write_to_rdram: u32 = 0xffff8000;
const wait_busy_and_full: u32 = 0x0c;
const wait_busy: u32 = 0x08;

pub export fn out(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: dmem,
) noreturn {
    reg($t2) flags: u32 = write_to_rdram | wait_busy_and_full;
    jump exec(size, pitch, rdram, dmem, flags);
}

pub export fn outAsync(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: dmem,
) noreturn {
    reg($t2) flags: u32 = write_to_rdram;
    jump exec(size, pitch, rdram, dmem, flags);
}

pub export fn inAsync(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: dmem,
) noreturn {
    reg($t2) flags: u32 = 0;
    jump exec(size, pitch, rdram, dmem, flags);
}

pub export fn in(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: dmem,
) noreturn {
    reg($t2) flags: u32 = wait_busy_and_full;
    tail exec(size, pitch, rdram, dmem, flags);
}

pub export fn exec(
    reg($t0) size: u32,
    reg($t1) pitch: u32,
    reg($s0) rdram: u32,
    reg($s4) dmem: dmem,
    reg($t2) flags: u32,
) noreturn {
    while (true) {
        reg($at) full: u32 = rsp.cp0.dmaFull();
        if (full == 0) {
            break;
        }
    }

    // The hardware descriptor packs the row skip (pitch minus row length)
    // above the length and row count already held in `size`.
    reg($at) descriptor: u32 = size & 0x0fff;
    descriptor = pitch - descriptor;
    descriptor -= 1;
    descriptor <<= 20;
    descriptor |= size;
    rsp.cp0.setDmaRdramAddress(rdram);
    rsp.cp0.setDmaMemoryAddress(dmem);
    if (flags < 0x80000000) {
        rsp.cp0.startDmaRead(descriptor);
    } else {
        rsp.cp0.startDmaWrite(descriptor);
    }

    reg($at) alignment: u32 = rdram & 7;
    dmem = dmem + alignment;
    flags &= 0x0f;
    jump waitStatus(flags);
}

pub export fn waitStatus(reg($t2) flags: u32) noreturn {
    while (true) {
        reg($at) status: u32 = rsp.cp0.spStatus();
        status &= flags;
        if (status == 0) {
            break;
        }
    }
    tail returnToCaller();
}

pub export fn returnToCaller() noreturn {
    reg($ra) return_address: u32 = undefined;
    jump(return_address);
}

pub export fn waitIdle() noreturn {
    reg($t2) flags: u32 = wait_busy_and_full;
    jump waitStatus(flags);
}

pub export fn waitOut() noreturn {
    reg($t2) flags: u32 = wait_busy;
    tail waitStatus(flags);
}
