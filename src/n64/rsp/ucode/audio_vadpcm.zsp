// VADPCM decoder, after libdragon's rsp_mixer.S (Giovanni Bajo, public
// domain). Each 9-byte frame holds a control byte (scale exponent and
// predictor index) and sixteen 4-bit residuals; an order-2 predictor turns
// them into sixteen 16-bit samples. Stereo streams alternate channels frame
// by frame, each channel with its own codebook bank and state.
const dma = import("resident_api.zsp");
const queue = import("resident_api.zsp");

data { identity: [8]u16 = .{2048,2048,2048,2048,2048,2048,2048,2048}; }
state { reserved_state: [16]u8; }
bss {
    // Codebook bank zero must have address bit 7 clear: flipping that bit
    // selects the other channel's bank.
    padding: [192]u8;
    pub codebook: [128]u16;
    // Two vectors of previous samples, one per channel.
    pub decoder_state: [16]u16;
    pub buffer: [1504]u16;
    // Room for the output's RDRAM misalignment.
    pub buffer_end: [8]u8;
}

const stereo: u32 = 0x80000000;
const codebook_bank_bit: dmem = 128;

/// Decodes the frames at `input_rdram` to `output_rdram`, whose top byte
/// holds the frame count minus one. `state_rdram` is the decoder state;
/// its bit 31 selects stereo. `codebook_rdram` holds the predictors.
@rspq.command(0) fn _start(
    input_rdram: u32,
    output_rdram: u32,
    state_rdram: u32,
    codebook_rdram: u32,
) @rspq.commandSize(16) noreturn {
    // The dispatcher's zero vector and shift constants.
    reg($v00) vector_zero: vec16 = undefined;
    reg($v30) shifts: vec16 = undefined;
    // The transposed predictor rows: transposed loads need eight
    // consecutive registers.
    reg($v08) predictors: [8]vec16 = undefined;
    reg pitch: u32 = undefined;

    dma.inAsync(255, pitch, codebook_rdram, codebook);
    dma.inAsync(31, pitch, state_rdram, decoder_state);

    // Start the predictor matrix as the identity on its diagonal.
    inline for (0..8) |row| {
        predictors[row] = predictors[row] ^ predictors[row];
    }
    rsp.vector.loadTranspose(predictors[0], 0, identity, 0);

    reg frames: u32 = output_rdram >>> 24;
    frames +%= 1;
    if (state_rdram >= stereo) {
        frames <<= 1;
    }

    // Decode in place: the input lands inside the output buffer at its
    // RDRAM distance, both shifted by the output's misalignment.
    input_rdram &= 0x00ffffff;
    output_rdram &= 0x00ffffff;
    reg input_offset: u32 = input_rdram - output_rdram;
    reg output: dmem = buffer;
    reg input: dmem = input_offset;
    input = input + output;
    reg misalignment: u32 = output_rdram & 7;
    output = output + misalignment;
    input = input + misalignment;
    reg output_size: u32 = frames << 5;
    if (misalignment != 0) {
        output_size +%= 8;
    }
    reg input_size: u32 = frames << 3;
    input_size = input_size + frames;
    reg input_misalignment: u32 = input_rdram & 7;
    if (input_misalignment != 0) {
        input_size +%= 8;
    }
    input_size +%= -1;
    reg input_dmem: dmem = input;
    dma.in(input_size, pitch, input_rdram, input_dmem);

    // Bit 31 flips after each channel of a stereo frame.
    reg toggle: u32 = state_rdram;
    reg state1: vec16 = load(vec16, decoder_state, 0);
    reg state3: vec16 = load(vec16, decoder_state, 16);
    reg channel_codebook: dmem = codebook;
    input += 1;

    frame: do {
        channel: do {
            // Control byte: scale is 1 << high nibble, predictor the low.
            reg control: u32 = load(u8, input, -1);
            reg residuals0: vec16 = undefined;
            reg residuals1: vec16 = undefined;
            rsp.vector.loadPackedSigned(residuals0, input, 0);
            rsp.vector.loadPackedSigned(residuals1, input, 0);
            reg scaling: u32 = control >>> 4;
            reg one: u32 = 1;
            scaling = one << scaling;
            reg scale: vec16 = undefined;
            scale[0] = scaling;
            reg predictor: dmem = control & 15;
            predictor = predictor << 5;
            predictor = predictor + channel_codebook;

            // Unpack the nibbles and scale them.
            residuals0 = vmudm(residuals0, shifts.wwwwwwww);
            residuals1 = vmudn(residuals1, shifts.wwwwwwww);
            residuals1 = vmudm(residuals1, shifts.wwwwwwww);
            residuals0 = vmudh(residuals0, scale.xxxxxxxx);
            residuals1 = vmudh(residuals1, scale.xxxxxxxx);

            // Order-2 predictor: row 0 and row 1, plus row 1 shifted by
            // one lane per residual.
            reg prediction0: vec16 = undefined;
            reg prediction1: vec16 = undefined;
            rsp.vector.loadQuad(prediction0, 0, predictor, 0);
            rsp.vector.loadQuad(prediction1, 0, predictor, 16);
            inline for (0..7) |row| {
                rsp.vector.loadQuad(predictors[row], row + 1, predictor, 16);
            }

            // Eight samples from the last two of the previous eight.
            reg discard: vec16 = vmudh(prediction0, state1.ZZZZZZZZ);
            discard = vmadh(prediction1, state1.WWWWWWWW);
            discard = vmadh(predictors[0], residuals0.xxxxxxxx);
            discard = vmadh(predictors[1], residuals1.xxxxxxxx);
            discard = vmadh(predictors[2], residuals0.yyyyyyyy);
            discard = vmadh(predictors[3], residuals1.yyyyyyyy);
            discard = vmadh(predictors[4], residuals0.zzzzzzzz);
            discard = vmadh(predictors[5], residuals1.zzzzzzzz);
            discard = vmadh(predictors[6], residuals0.wwwwwwww);
            discard = vmadh(predictors[7], residuals1.wwwwwwww);
            reg fraction: vec16 = accumulator(.middle);
            reg state0: vec16 = accumulator(.high);
            discard = vmudn(fraction, shifts.zzzzzzzz);
            state0 = vmadh(state0, shifts.zzzzzzzz);

            // And the next eight from those.
            discard = vmudh(prediction0, state0.ZZZZZZZZ);
            discard = vmadh(prediction1, state0.WWWWWWWW);
            discard = vmadh(predictors[0], residuals0.XXXXXXXX);
            discard = vmadh(predictors[1], residuals1.XXXXXXXX);
            discard = vmadh(predictors[2], residuals0.YYYYYYYY);
            discard = vmadh(predictors[3], residuals1.YYYYYYYY);
            discard = vmadh(predictors[4], residuals0.ZZZZZZZZ);
            discard = vmadh(predictors[5], residuals1.ZZZZZZZZ);
            discard = vmadh(predictors[6], residuals0.WWWWWWWW);
            discard = vmadh(predictors[7], residuals1.WWWWWWWW);
            fraction = accumulator(.middle);
            state1 = accumulator(.high);
            discard = vmudn(fraction, shifts.zzzzzzzz);
            state1 = vmadh(state1, shifts.zzzzzzzz);

            store(vec16, output, state0, 0);
            rsp.vector.storeRight(state0, output, 16);
            store(vec16, output, state1, 16);
            rsp.vector.storeRight(state1, output, 32);
            frames +%= -1;
            input +%= 9;
            output +%= 32;
            if (state_rdram < stereo) {
                continue frame;
            }

            // Stereo: decode the other channel with its state and bank.
            state1 = vector_zero | state3;
            channel_codebook = channel_codebook ^ codebook_bank_bit;
            reg first_channel: u32 = toggle;
            toggle = toggle ^ state_rdram;
        } while (first_channel >= stereo);

        // Interleave the two channels' 16 samples each.
        output +%= -64;
        reg left0: vec16 = load(vec16, output, 0);
        rsp.vector.loadRight(left0, output, 16);
        state1 = load(vec16, output, 16);
        rsp.vector.loadRight(state1, output, 32);
        reg right0: vec16 = load(vec16, output, 32);
        rsp.vector.loadRight(right0, output, 48);
        state3 = load(vec16, output, 48);
        rsp.vector.loadRight(state3, output, 64);
        interleave: do {
            inline for (0..8) |lane| {
                store(vec16, output, left0[lane], lane * 4);
                store(vec16, output, right0[lane], lane * 4 + 2);
            }
            left0 = vector_zero | state1;
            right0 = vector_zero | state3;
            output +%= 32;
            reg first_half: u32 = toggle;
            toggle = toggle ^ state_rdram;
        } while (first_half >= stereo);
    } while (frames > 0);

    store(vec16, decoder_state, state1, 0);
    store(vec16, decoder_state, state3, 16);
    dma.outAsync(31, pitch, state_rdram, decoder_state);

    // A misaligned output starts mid-word: keep the RDRAM bytes before it.
    reg head: u32 = output_rdram & 7;
    if (head != 0) {
        dma.in(head, pitch, output_rdram, decoder_state);
        reg from: dmem = decoder_state;
        reg to: dmem = buffer;
        do {
            reg halfword: u32 = load(u16, from, 0);
            from +%= 2;
            head +%= -2;
            store(u16, to, halfword, 0);
            to +%= 2;
        } while (head != 0);
    }
    output_size +%= -1;
    dma.out(output_size, pitch, output_rdram, buffer);
    jump queue.commandLoop();
}

/// Clears the decoder state at `state_rdram`, or copies it from
/// `initial_rdram` when that is not zero.
@rspq.command(1) fn setState(
    state_rdram: u32,
    initial_rdram: u32,
) @rspq.commandSize(8) noreturn {
    reg($v00) vector_zero: vec16 = undefined;
    reg pitch: u32 = undefined;
    store(vec16, decoder_state, vector_zero, 0);
    store(vec16, decoder_state, vector_zero, 16);
    if (initial_rdram != 0) {
        dma.in(31, pitch, initial_rdram, decoder_state);
    }
    dma.out(31, pitch, state_rdram, decoder_state);
    jump queue.commandLoop();
}
