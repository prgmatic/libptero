// PCM mixer, after libdragon's src/audio/rsp_mixer.S by Giovanni Bajo
// (public domain, the Unlicense). Each batch resamples every active channel
// into a 32-channel sample matrix, then mixes the matrix down to stereo with
// per-channel volumes that ramp toward their targets.
const dma = import("resident_api.zsp");
const queue = import("resident_api.zsp");

packed struct Channel {
    // 20.12 position within the waveform, in bytes.
    position: u32;
    step: u32;
    length: u32;
    loop_length: u32;
    sample_address: u32;
    flags: u32;
}

data {
    // Lane 1 and 2: the ramp's decay and approach factors.
    pub constants: [8]u16 = .{ 32767, 57462, 8074, 0, 0, 0, 0, 0 };
    banner0: [16]u8 = .{ 68, 114, 97, 103, 111, 110, 32, 82, 83, 80, 32, 65, 117, 100, 105, 111 };
    banner1: [16]u8 = .{ 32, 67, 111, 100, 101, 100, 32, 98, 121, 32, 82, 97, 115, 107, 121, 32 };
    identity: [8]u16 = .{ 2048, 2048, 2048, 2048, 2048, 2048, 2048, 2048 };
}
state {
    // The ramped volumes carried between commands.
    pub current_volume_left: [32]u16;
    pub current_volume_right: [32]u16;
}
bss {
    pub output_rdram: u32;
    global_volume: u16;
    samples_remaining: u16;
    configured_channels: u16;
    input_padding: [6]u8;
    // Settings DMA'd from and back to the CPU: target volumes, then one
    // `Channel` per slot.
    pub volume_left: [32]u16;
    volume_right: [32]u16;
    pub channels: [32]Channel;
    // Samples for the channel being resampled, addressed by position.
    pub sample_cache: [64]u8;
    // One 64-byte row per output sample: a 16-bit value for each channel.
    pub channel_buffer: [1024]u16;
    pub output_buffer: [64]u16;
}


const flag_stereo: u32 = 8;
const flag_pcm16: u32 = 4;
const format_bits: u32 = flag_stereo | flag_pcm16;
const max_batch: u32 = 32;
const settings_size: u32 = 895;
const settings_read: u32 = 12;
const settings_write: u32 = 0xffff8000;
const command_buffer: u32 = 0xa0;

/// Mixes `counts >> 16` samples of `counts & 0xffff` channels at `volume`
/// into `output`, using the settings at `settings`.
@rspq.command(0) fn _start(
    volume: u32,
    counts: u32,
    output: u32,
    settings: u32,
) @rspq.commandSize(16) noreturn {
    reg($v00) vector_zero: vec16 = undefined;
    vector_zero = vector_zero ^ vector_zero;
    reg ramp: vec16 = load(vec16, constants, 0);
    volume &= 0xffff;
    reg remaining: u32 = counts >>> 16;
    reg channel_count: u32 = counts & 0xffff;
    reg pitch: u32 = undefined;
    dma.exec(settings_size, pitch, settings, volume_left, settings_read);

    // Volumes for groups of eight channels: targets scaled by the global
    // volume, and the ramped ones from the last command.
    reg target_left: [4]vec16 = undefined;
    reg target_right: [4]vec16 = undefined;
    reg left: [4]vec16 = undefined;
    reg right: [4]vec16 = undefined;
    reg global: vec16 = undefined;
    global[0] = volume;
    global = vector_zero | global.xxxxxxxx;
    inline for (0..4) |group| {
        target_left[group] = load(vec16, volume_left, group * 16);
        target_right[group] = load(vec16, volume_left, 64 + group * 16);
        target_left[group] = vmudl(target_left[group], global);
        target_right[group] = vmudl(target_right[group], global);
    }
    inline for (0..4) |group| {
        left[group] = load(vec16, current_volume_left, group * 16);
        right[group] = load(vec16, current_volume_left, 64 + group * 16);
    }

    while (remaining != 0) {
        // A misaligned output keeps the 4 bytes before it, so the batch
        // shrinks by one sample.
        reg misaligned: u32 = output & 7;
        misaligned = signedLessThan(0, misaligned);
        reg batch: u32 = max_batch - misaligned;
        reg fits: u32 = signedLessThan(batch, remaining);
        if (fits == 0) {
            batch = remaining;
        }
        remaining = remaining - batch;

        // ---- resample every active channel into the sample matrix
        reg row: dmem = channel_buffer;
        reg rows_left: u32 = 32;
        do {
            inline for (0..4) |quarter| {
                store(vec16, row, vector_zero, quarter * 16);
            }
            row = row + 64;
            rows_left += -1;
        } while (rows_left != 0);

        // Positions inside the cache are shifted so that `position >> 12` is
        // the sample's DMEM address.
        reg cache_limit: dmem = dmem.addressOf(sample_cache, 64);
        reg cache_end: u32 = cache_limit;
        cache_end <<= 12;
        reg channel: *Channel = channels;
        reg channel_index: u32 = 0;
        do {
            reg sample_address: u32 = channel.sample_address;
            reg position: u32 = channel.position;
            reg format: u32 = channel.flags;
            format &= format_bits;
            if (sample_address != 0) {
                reg step: u32 = channel.step;
                reg length: u32 = channel.length;
                reg loop_length: u32 = channel.loop_length;
                // Column `channel_index` of the sample matrix.
                reg column: dmem = channel_index + channel_buffer;
                column = column + channel_index;
                reg ticks: i32 = undefined;
                ticks = bitCast(batch);

                refill: while (true) {
                    // Wrap into the loop, or stop at the end of the waveform.
                    while (position >= length) {
                        if (loop_length == 0) {
                            break refill;
                        }
                        position = position - loop_length;
                    }
                    // Fetch the next 64 bytes; the DMA leaves `cache` at the
                    // first byte it asked for.
                    reg sample_offset: u32 = position >>> 12;
                    reg rdram: u32 = sample_offset + sample_address;
                    reg cache: dmem = sample_cache;
                    reg no_pitch: u32 = undefined;
                    dma.in(63, no_pitch, rdram, cache);
                    reg position_offset: u32 = sample_offset - cache;
                    position_offset <<= 12;
                    position = position - position_offset;
                    if (format < flag_stereo) {
                        if (format == 0) {
                            resampleMono8(position, step, ticks, column, cache_end);
                        } else {
                            resampleMono16(position, step, ticks, column, cache_end);
                        }
                    } else {
                        if (format == flag_stereo) {
                            resampleStereo8(position, step, ticks, column, cache_end);
                        } else {
                            resampleStereo16(position, step, ticks, column, cache_end);
                        }
                    }
                    position = position + position_offset;
                    if (ticks <= 0) {
                        break refill;
                    }
                }
                channel.position = position;
                // A stereo channel also fills the next column.
                reg stereo_slot: u32 = format & flag_stereo;
                if (stereo_slot != 0) {
                    channel_index += 1;
                    channel += sizeOf(Channel);
                }
            }
            channel_index += 1;
            channel += sizeOf(Channel);
        } while (channel_index != channel_count);
        reg output_start: dmem = output_buffer;
        reg head: u32 = output & 7;
        if (head != 0) {
            reg no_pitch: u32 = undefined;
            dma.in(7, no_pitch, output, output_buffer);
            output_start += 4;
        }

        // ---- mix the matrix to stereo, ramping volumes every 8 samples;
        // up to 8 channels use only the first group of each side
        reg mix_row: dmem = channel_buffer;
        reg matrix: [4]vec16 = undefined;
        inline for (0..4) |quarter| {
            matrix[quarter] = load(vec16, mix_row, quarter * 16);
        }
        // Each iteration stores the previous sample's sums, which hides the
        // sums' latency. The first store rewrites the bytes before `output_start`.
        reg left_sample: vec16 = undefined;
        reg right_sample: vec16 = undefined;
        left_sample[0] = load(vec16, output_start, -4);
        right_sample[0] = load(vec16, output_start, -2);
        reg mix_remaining: i32 = undefined;
        mix_remaining = bitCast(batch);
        if (channel_count > 8) {
            do {
                reg samples: i32 = 8;
                if (mix_remaining < 8) {
                    samples = mix_remaining;
                }
                do {
                    reg left_sum: vec16 = vmulf(matrix[0], left[0]);
                    inline for (1..4) |group| {
                        left_sum = vmacf(matrix[group], left[group]);
                    }
                    store(vec16, output_start, left_sample[0], -4);
                    store(vec16, output_start, right_sample[0], -2);
                    reg right_sum: vec16 = vmulf(matrix[0], right[0]);
                    inline for (1..4) |group| {
                        right_sum = vmacf(matrix[group], right[group]);
                    }
                    mix_row = mix_row + 64;
                    samples += -1;
                    output_start = output_start + 4;
                    sumLanes(left_sample, left_sum, right_sample, right_sum);
                    inline for (0..4) |quarter| {
                        matrix[quarter] = load(vec16, mix_row, quarter * 16);
                    }
                } while (samples != 0);
                inline for (0..4) |group| {
                    left[group] = vmudm(left[group], ramp.yyyyyyyy);
                    left[group] = vmadm(target_left[group], ramp.zzzzzzzz);
                    right[group] = vmudm(right[group], ramp.yyyyyyyy);
                    right[group] = vmadm(target_right[group], ramp.zzzzzzzz);
                }
                mix_remaining += -8;
            } while (mix_remaining > 0);
        } else {
            do {
                reg samples: i32 = 8;
                if (mix_remaining < 8) {
                    samples = mix_remaining;
                }
                do {
                    reg left_sum: vec16 = vmulf(matrix[0], left[0]);
                    store(vec16, output_start, left_sample[0], -4);
                    reg right_sum: vec16 = vmulf(matrix[0], right[0]);
                    store(vec16, output_start, right_sample[0], -2);
                    samples += -1;
                    mix_row = mix_row + 64;
                    output_start = output_start + 4;
                    sumLanes(left_sample, left_sum, right_sample, right_sum);
                    matrix[0] = load(vec16, mix_row, 0);
                } while (samples != 0);
                left[0] = vmudm(left[0], ramp.yyyyyyyy);
                left[0] = vmadm(target_left[0], ramp.zzzzzzzz);
                right[0] = vmudm(right[0], ramp.yyyyyyyy);
                right[0] = vmadm(target_right[0], ramp.zzzzzzzz);
                mix_remaining += -8;
            } while (mix_remaining > 0);
        }
        store(vec16, output_start, left_sample[0], -4);
        store(vec16, output_start, right_sample[0], -2);

        reg size: u32 = batch << 2;
        reg destination: u32 = output;
        output = destination + size;
        size += -1;
        reg no_pitch: u32 = undefined;
        dma.outAsync(size, no_pitch, destination, output_buffer);
    }

    inline for (0..4) |group| {
        store(vec16, current_volume_left, left[group], group * 16);
        store(vec16, current_volume_left, right[group], 64 + group * 16);
    }
    // The settings address is the command's last word, before `$gp`.
    reg($gp) command_end: dmem = undefined;
    reg settings_rdram: u32 = load(u32, command_buffer + command_end, -4);
    reg final_pitch: u32 = undefined;
    dma.exec(settings_size, final_pitch, settings_rdram, volume_left, settings_write);
    dma.waitIdle();
    tail queue.commandLoop();
}



// Each resampler copies samples into the column until `ticks` runs out or
// the cache does: eight at a time while both last, then one at a time.
// 8-bit samples go to the high byte of their 16-bit cell.

inline fn resampleMono8(position: u32, step: u32, ticks: i32, column: dmem, cache_end: u32) {
    reg batch_step: u32 = step << 3;
    while (true) {
        reg batch_end: u32 = position + batch_step;
        reg overflows: u32 = signedLessThan(cache_end, batch_end);
        if (overflows != 0) { break; }
        reg short: u32 = signedLessThan(ticks, 8);
        if (short != 0) { break; }
        inline for (0..8) |sample| {
            reg address: dmem = position >>> 12;
            reg value: u32 = load(u8, address, 0);
            position = position + step;
            store(u8, column, value, sample * 64);
        }
        column = column + 512;
        ticks += -8;
    }
    while (ticks > 0) {
        reg inside: u32 = signedLessThan(position, cache_end);
        if (inside == 0) { break; }
        reg address: dmem = position >>> 12;
        reg value: u32 = load(u8, address, 0);
        position = position + step;
        store(u8, column, value, 0);
        column = column + 64;
        ticks += -1;
    }
}

inline fn resampleMono16(position: u32, step: u32, ticks: i32, column: dmem, cache_end: u32) {
    reg batch_step: u32 = step << 3;
    while (true) {
        reg batch_end: u32 = position + batch_step;
        reg overflows: u32 = signedLessThan(cache_end, batch_end);
        if (overflows != 0) { break; }
        reg short: u32 = signedLessThan(ticks, 8);
        if (short != 0) { break; }
        inline for (0..8) |sample| {
            reg address: dmem = position >>> 13;
            address = address << 1;
            reg value: u32 = load(u16, address, 0);
            position = position + step;
            store(u16, column, value, sample * 64);
        }
        column = column + 512;
        ticks += -8;
    }
    while (ticks > 0) {
        reg inside: u32 = signedLessThan(position, cache_end);
        if (inside == 0) { break; }
        reg address: dmem = position >>> 13;
        address = address << 1;
        reg value: u32 = load(u16, address, 0);
        position = position + step;
        store(u16, column, value, 0);
        column = column + 64;
        ticks += -1;
    }
}

inline fn resampleStereo8(position: u32, step: u32, ticks: i32, column: dmem, cache_end: u32) {
    reg batch_step: u32 = step << 3;
    while (true) {
        reg batch_end: u32 = position + batch_step;
        reg overflows: u32 = signedLessThan(cache_end, batch_end);
        if (overflows != 0) { break; }
        reg short: u32 = signedLessThan(ticks, 8);
        if (short != 0) { break; }
        inline for (0..8) |sample| {
            reg address: dmem = position >>> 13;
            address = address << 1;
            reg left: u32 = load(u8, address, 0);
            reg right: u32 = load(u8, address, 1);
            position = position + step;
            store(u8, column, left, sample * 64);
            store(u8, column, right, sample * 64 + 2);
        }
        column = column + 512;
        ticks += -8;
    }
    while (ticks > 0) {
        reg inside: u32 = signedLessThan(position, cache_end);
        if (inside == 0) { break; }
        reg address: dmem = position >>> 13;
        address = address << 1;
        reg left: u32 = load(u8, address, 0);
        reg right: u32 = load(u8, address, 1);
        position = position + step;
        store(u8, column, left, 0);
        store(u8, column, right, 2);
        column = column + 64;
        ticks += -1;
    }
}

inline fn resampleStereo16(position: u32, step: u32, ticks: i32, column: dmem, cache_end: u32) {
    reg batch_step: u32 = step << 3;
    while (true) {
        reg batch_end: u32 = position + batch_step;
        reg overflows: u32 = signedLessThan(cache_end, batch_end);
        if (overflows != 0) { break; }
        reg short: u32 = signedLessThan(ticks, 8);
        if (short != 0) { break; }
        inline for (0..8) |sample| {
            reg address: dmem = position >>> 14;
            address = address << 2;
            reg pair: u32 = load(u32, address, 0);
            position = position + step;
            store(u32, column, pair, sample * 64);
        }
        column = column + 512;
        ticks += -8;
    }
    while (ticks > 0) {
        reg inside: u32 = signedLessThan(position, cache_end);
        if (inside == 0) { break; }
        reg address: dmem = position >>> 14;
        address = address << 2;
        reg pair: u32 = load(u32, address, 0);
        position = position + step;
        store(u32, column, pair, 0);
        column = column + 64;
        ticks += -1;
    }
}



/// Lane 0 of each sum becomes the sum of all eight lanes. `vadd` carries
/// through VCO, so the adds keep their order: alternating the two sides
/// gives each add time for the previous one's result.
inline fn sumLanes(left_sum: vec16, left_lanes: vec16, right_sum: vec16, right_lanes: vec16) {
    left_sum = vadd(left_lanes, left_lanes.yywwYYWW);
    right_sum = vadd(right_lanes, right_lanes.yywwYYWW);
    left_sum = vadd(left_sum, left_sum.zzzzZZZZ);
    right_sum = vadd(right_sum, right_sum.zzzzZZZZ);
    left_sum = vadd(left_sum, left_sum.XXXXXXXX);
    right_sum = vadd(right_sum, right_sum.XXXXXXXX);
}
