inline pub fn getDmaFull(reg($t3) value: u32) {
    asm("mfc0 $t3, $5");
}

inline pub fn getSpStatus(reg($t3) value: u32) {
    asm("mfc0 $t3, $4");
}

inline pub fn setSpStatus(reg($t3) value: u32) {
    asm("mtc0 $t3, $4");
}

inline pub fn setDmaAddrRsp(reg($s4) value: u32) {
    asm("mtc0 $s4, $0");
}

inline pub fn setDmaAddrRdram(reg($s0) value: u32) {
    asm("mtc0 $s0, $1");
}

inline pub fn setDmaRead(reg($t3) value: u32) {
    asm("mtc0 $t3, $2");
}

inline pub fn setDmaWrite(reg($t3) value: u32) {
    asm("mtc0 $t3, $3");
}

inline pub fn getDpStart(reg($t3) value: u32) {
    asm("mfc0 $t3, $8");
}

inline pub fn setDpStart(reg($a1) value: u32) {
    asm("mtc0 $a1, $8");
}

inline pub fn setDpEnd(reg($a0) value: u32) {
    asm("mtc0 $a0, $9");
}

inline pub fn getDpStatus(reg($t3) value: u32) {
    asm("mfc0 $t3, $11");
}
